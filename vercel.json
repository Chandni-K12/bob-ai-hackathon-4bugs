{
  "version": 2,
  "buildCommand": "cd src/client && npm install && npm run build",
  "outputDirectory": "src/client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/src/api" }
  ],
  "functions": {
    "src/api/index.js": {
      "memory": 512,
      "maxDuration": 30
    }
  }
}
