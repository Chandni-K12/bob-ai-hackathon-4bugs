# ─── Frontend (src/client/.env) ──────────────────────────────────────────────
VITE_API_URL=/api
VITE_AI_URL=http://localhost:8000

# ─── Express server (src/server/.env) ────────────────────────────────────────
PORT=5000
MONGODB_URI=mongodb://localhost:27017/gengreen
JWT_SECRET=gengreen_sih_secret_key_2026

# ─── AI service only (src/ai-service/.env) ───────────────────────────────────

# IBM Bob inference key — create one at bob.ibm.com → API Keys → Inference
BOB_API_KEY=your_bob_api_key_here

# watsonx.ai endpoint — the Bob key authenticates here
BOB_API_ENDPOINT=https://us-south.ml.cloud.ibm.com

# watsonx.ai project ID — find at bob.ibm.com → subscription → Settings
WATSONX_PROJECT_ID=your_project_id_here

# Optional: override the default model (default: ibm/granite-3-8b-instruct)
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Express server base URL used by ai-service to fetch class analytics
SERVER_BASE_URL=http://localhost:5000
